#!/usr/bin/env python3
"""Refuse, on the evidence the image carries.

Every pipeline step records its outcome and exits zero, so the build always
succeeds and the evidence always survives. This program is what says no. The
workflow builds the image, publishes it, and then starts this program against
the published digest -- so "the evidence exists" holds by construction rather
than by getting two workflow steps into the right order. If the push fails
there is no digest, and the refusal cannot run at all.

It reads two things:

  the ledger      which phases were expected  (default /pipeline/phases.yaml)
  the evidence    what each phase recorded    (default /evidence)

and refuses unless every expected phase both ran and passed.

`--gate <build|qa|uat|prod>` narrows "expected" to the phases due BY that gate.
The ledger has always carried `due_by` and this program has always ignored it,
which meant a phase declared due at qa was demanded at build -- so a sponsor
image, whose browser suite cannot run inside a hermetic build, could never pass
its own build gate. Without the flag every declared phase is still required,
because weakening a gate that other things already depend on, silently, is
worse than making a caller say which gate it means.

A phase that is declared but not yet due is reported as deferred rather than
omitted. "This gate did not ask" and "nobody declared it" must not look alike.

An ABSENT verdict is a refusal, not a pass. A missing .rc file means the step
never reached the wrapper, which is indistinguishable from the step never
running -- and treating that as success is the same class of defect as a secret
scan that reports clean on a leaking image.

Stdlib only, deliberately. The dependency install is itself a phase, and it is
the phase this pipeline's discriminating check deliberately breaks. A refusal
program that imported PyYAML would fail to start in exactly the case it exists
to report. The ledger is therefore parsed with a restricted reader that
understands the one shape this file is allowed to take, and rejects anything
else rather than guessing.

Diagnostics go to stderr. Stdout carries a single JSON object, so a later step
can join this verdict without re-deriving it -- and so that nothing chatty can
corrupt a caller that is reading stdout.

Exit status:
  0  every phase due by this gate ran and passed
  1  at least one expected phase is absent, unreadable, or failed
  2  the ledger or the evidence directory could not be read at all
"""

from __future__ import annotations

import json
import os
import re
import sys

DEFAULT_LEDGER = "/pipeline/phases.yaml"
DEFAULT_LEDGER_DIR = "/pipeline/phases.d"
DEFAULT_EVIDENCE = "/evidence"

# The one shape the ledger is allowed to take. Anything else is an error rather
# than a best-effort parse: a ledger this program silently misreads is a ledger
# that can declare phases nobody checks.
_REPO_KEY = re.compile(r"^repo:\s*([A-Za-z0-9][A-Za-z0-9._-]*)\s*$")
_PHASES_KEY = re.compile(r"^phases:\s*$")
_ITEM_ID = re.compile(r"^\s{2,}-\s+id:\s*([A-Za-z0-9][A-Za-z0-9._-]*)\s*$")
_ITEM_FIELD = re.compile(r"^\s{4,}[A-Za-z_][A-Za-z0-9_]*:\s*\S.*$")
_ITEM_DUE_BY = re.compile(r"^\s{4,}due_by:\s*([A-Za-z][A-Za-z0-9_-]*)\s*$")
_COMMENT_OR_BLANK = re.compile(r"^\s*(#.*)?$")


# The gates, in the order a change passes through them. A phase declared
# `due_by: qa` is due at qa and at every gate after it, and is NOT due at build.
# Declared here rather than inferred, because "which gate comes first" is a
# fact about this estate and not something to guess from a string.
GATES = ("build", "qa", "uat", "prod")


class LedgerError(Exception):
    """The ledger could not be read in the one shape it is allowed to take."""


def read_ledger(path: str) -> tuple[str | None, list[tuple[str, str | None]]]:
    """Return (repo, [(phase id, due_by)]) for one ledger.

    `due_by` is carried now rather than discarded. It was always in the file and
    always ignored, which meant a phase declared due at qa was demanded at build
    and the sponsor image could never pass its own gate.

    `repo` is the namespace the phases' evidence lives under, or None when the
    ledger declares none -- a single-repository image, which is what the root
    of the chain builds.
    """
    try:
        with open(path, "r", encoding="utf-8") as handle:
            lines = handle.read().splitlines()
    except OSError as exc:
        raise LedgerError(f"cannot read ledger {path}: {exc}") from exc

    seen_key = False
    repo: str | None = None
    ids: list[str] = []
    for number, line in enumerate(lines, start=1):
        if _COMMENT_OR_BLANK.match(line):
            continue
        if not seen_key:
            declared = _REPO_KEY.match(line)
            if declared:
                if repo is not None:
                    raise LedgerError(f"{path}:{number}: 'repo:' declared twice")
                repo = declared.group(1)
                continue
            if _PHASES_KEY.match(line):
                seen_key = True
                continue
            raise LedgerError(
                f"{path}:{number}: expected 'repo:' or 'phases:', got {line!r}"
            )
        item = _ITEM_ID.match(line)
        if item:
            phase = item.group(1)
            if phase in [name for name, _ in ids]:
                raise LedgerError(f"{path}:{number}: phase {phase!r} declared twice")
            ids.append((phase, None))
            continue
        field = _ITEM_FIELD.match(line)
        if field:
            if not ids:
                raise LedgerError(f"{path}:{number}: field before any '- id:' entry")
            due = _ITEM_DUE_BY.match(line)
            if due:
                gate = due.group(1)
                if gate not in GATES:
                    raise LedgerError(
                        f"{path}:{number}: due_by {gate!r} is not a gate "
                        f"({', '.join(GATES)})"
                    )
                name, _ = ids[-1]
                ids[-1] = (name, gate)
            continue
        raise LedgerError(f"{path}:{number}: unrecognised line {line!r}")

    if not seen_key:
        raise LedgerError(f"{path}: no 'phases:' key")
    if not ids:
        # An empty ledger must not pass. A gate that reads an empty expectation
        # and reports success is the vacuous pass this whole mechanism exists to
        # make impossible.
        raise LedgerError(f"{path}: declares no phases")
    return repo, ids


def judge(phase: str, evidence_dir: str) -> tuple[bool, str]:
    """Return (passed, reason) for one phase, from what it left behind."""
    rc_path = os.path.join(evidence_dir, f"{phase}.rc")
    log_path = os.path.join(evidence_dir, f"{phase}.log")

    if not os.path.exists(rc_path):
        return False, "did not run (no verdict recorded)"

    try:
        with open(rc_path, "r", encoding="utf-8") as handle:
            raw = handle.read().strip()
    except OSError as exc:
        return False, f"verdict unreadable ({exc})"

    if not re.fullmatch(r"-?\d+", raw):
        return False, f"verdict is not a status ({raw!r})"

    if not os.path.exists(log_path):
        # The wrapper writes the log before it writes the status, so a status
        # with no log means something other than the wrapper wrote it.
        return False, "status recorded without a log"

    status = int(raw)
    if status != 0:
        return False, f"failed with status {status}"
    return True, "ran and passed"


def main(argv: list[str]) -> int:
    ledger_path = os.environ.get("PIPELINE_LEDGER", DEFAULT_LEDGER)
    ledger_dir = os.environ.get("PIPELINE_LEDGER_DIR", DEFAULT_LEDGER_DIR)
    evidence_dir = os.environ.get("EVIDENCE_ROOT", DEFAULT_EVIDENCE)
    # --gate asks a narrower question: is everything due BY this gate present?
    # Without it the question is "is everything present", which is what every
    # caller asked before this existed and stays the default, because silently
    # weakening a gate that other things already depend on is worse than making
    # callers say which gate they mean.
    gate = None
    rest = []
    pending = argv[1:]
    while pending:
        item = pending.pop(0)
        if item == "--gate":
            if not pending:
                print("refuse: --gate needs a gate name", file=sys.stderr)
                return 2
            gate = pending.pop(0)
        elif item.startswith("--gate="):
            gate = item.split("=", 1)[1]
        else:
            rest.append(item)

    if gate is not None and gate not in GATES:
        print(
            f"refuse: {gate!r} is not a gate ({', '.join(GATES)})",
            file=sys.stderr,
        )
        return 2

    if rest:
        ledger_path = rest[0]
        ledger_dir = rest[0] if os.path.isdir(rest[0]) else ledger_dir
    if len(rest) > 1:
        evidence_dir = rest[1]

    # A consumer inherits its upstream's image, so one image can carry several
    # ledgers -- the platform's and the sponsor's. They are separate files in a
    # directory rather than one file two repositories edit, because the second
    # writer would otherwise silently replace the first, and the phase that
    # disappeared would be the upstream's.
    ledgers: list[str] = []
    if os.path.isdir(ledger_dir):
        ledgers = sorted(
            os.path.join(ledger_dir, name)
            for name in os.listdir(ledger_dir)
            if name.endswith((".yaml", ".yml"))
        )
    if not ledgers and os.path.exists(ledger_path):
        ledgers = [ledger_path]
    if not ledgers:
        print(
            f"refuse: no ledger at {ledger_path} and none in {ledger_dir}; "
            "this image declares no phases, so nothing can be checked",
            file=sys.stderr,
        )
        return 2

    try:
        declared = [read_ledger(path) for path in ledgers]
    except LedgerError as exc:
        print(f"refuse: {exc}", file=sys.stderr)
        return 2

    # `None` is a namespace too -- the evidence root itself. Filtering it out
    # before the duplicate check meant two ledgers that simply omit `repo:`
    # both landed at the root, where the second's phases judged the first's
    # evidence. That is the exact substitution this guard exists to prevent,
    # reachable by leaving a key out rather than by getting it wrong.
    seen_repos = [repo for repo, _ in declared]
    if len(seen_repos) != len(set(seen_repos)):
        if None in seen_repos and seen_repos.count(None) > 1:
            print(
                "refuse: two ledgers declare no repo, so both would be judged "
                "against the evidence root -- give each one a `repo:`",
                file=sys.stderr,
            )
        else:
            print("refuse: two ledgers declare the same repo", file=sys.stderr)
        return 2

    if not os.path.isdir(evidence_dir):
        # Not a refusal about one phase -- nothing was recorded at all, which
        # means this image is not one this program can judge.
        print(
            f"refuse: no evidence directory at {evidence_dir}; "
            "this image carries no record of its own build",
            file=sys.stderr,
        )
        return 2

    results = {}
    refusals = []
    expected = []
    deferred = []
    for repo, phases in declared:
        # Evidence is namespaced by the repository that produced it. Without
        # this, a consumer running a phase its upstream also ran would write
        # over the upstream's result, and a report meant to cover both would
        # quietly cover one.
        where = os.path.join(evidence_dir, repo) if repo else evidence_dir
        for phase, due_by in phases:
            key = f"{repo}/{phase}" if repo else phase
            if gate is not None and due_by is not None and GATES.index(due_by) > GATES.index(gate):
                # Declared, and not due yet. Not the same as absent: the ledger
                # still names it, so it cannot be quietly forgotten -- it is
                # simply not this gate's business.
                deferred.append(f"{key} (due by {due_by})")
                continue
            expected.append(key)
            passed, reason = judge(phase, where)
            results[key] = {"passed": passed, "reason": reason}
            marker = "ok " if passed else "REFUSE"
            print(f"{marker}  {key}: {reason}", file=sys.stderr)
            if not passed:
                refusals.append(key)

    # `deferred` is in the verdict on purpose. A reader must be able to tell
    # "this gate did not ask about e2e" from "nobody declared e2e", and only one
    # of those is acceptable.
    verdict = {
        "ledgers": ledgers,
        "evidence": evidence_dir,
        "gate": gate,
        "expected": expected,
        "deferred": deferred,
        "phases": results,
        "refused": refusals,
        "passed": not refusals,
    }
    for item in deferred:
        print(f"later   {item}", file=sys.stderr)

    print(json.dumps(verdict, indent=2, sort_keys=True))

    if refusals:
        print(
            "refuse: refusing on "
            + ", ".join(refusals)
            + f" ({len(refusals)} of {len(expected)} expected phases)",
            file=sys.stderr,
        )
        return 1

    print(f"refuse: {len(expected)} expected phases ran and passed", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
